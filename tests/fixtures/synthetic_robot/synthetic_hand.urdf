<robot name="synthetic_hand">
  <link name="palm">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.2 0.2 0.1"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.2 0.2 0.1"/></geometry></collision>
  </link>
  <link name="finger1">
    <visual><origin xyz="0.5 0 0" rpy="0 0 0"/><geometry><sphere radius="0.05"/></geometry></visual>
    <collision><origin xyz="0.5 0 0" rpy="0 0 0"/><geometry><sphere radius="0.04"/></geometry></collision>
  </link>
  <link name="finger2">
    <visual><origin xyz="0.5 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.03" length="0.3"/></geometry></visual>
    <collision><origin xyz="0.5 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.1 0.1"/></geometry></collision>
  </link>
  <link name="slider">
    <visual><geometry><box size="0.1 0.1 0.1"/></geometry></visual>
    <collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision>
  </link>
  <link name="synthetic_tip">
    <visual><geometry><sphere radius="0.02"/></geometry></visual>
  </link>
  <joint name="joint_rev_z" type="revolute">
    <parent link="palm"/><child link="finger1"/><origin xyz="1 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 2"/><limit lower="-1.5707963267948966" upper="1.5707963267948966" effort="1" velocity="2"/>
  </joint>
  <joint name="joint_rev_y" type="revolute">
    <parent link="finger1"/><child link="finger2"/><origin xyz="1 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-1" upper="1" effort="1" velocity="2"/>
  </joint>
  <joint name="joint_slide" type="prismatic">
    <parent link="finger2"/><child link="slider"/><origin xyz="1 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/><limit lower="0" upper="0.5" effort="1" velocity="1"/>
  </joint>
  <joint name="joint_tip" type="fixed">
    <parent link="slider"/><child link="synthetic_tip"/><origin xyz="0.2 0 0" rpy="0 0 0"/>
  </joint>
</robot>
