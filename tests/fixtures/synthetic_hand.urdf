<robot name="synthetic_hand">
  <link name="palm">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.2 0.1 0.04"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.2 0.1 0.04"/></geometry></collision>
  </link>
  <link name="link1">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.03 0.03"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.02" length="0.1"/></geometry></collision>
  </link>
  <link name="link2">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><sphere radius="0.02"/></geometry></visual>
  </link>
  <link name="tip"/>
  <joint name="bend" type="revolute">
    <parent link="palm"/><child link="link1"/>
    <origin xyz="0.1 0 0" rpy="0 0 0.2"/>
    <axis xyz="0 0 2"/>
    <limit lower="-1" upper="1" effort="2" velocity="3"/>
  </joint>
  <joint name="slide" type="prismatic">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 4"/>
    <limit lower="0" upper="0.05" effort="2" velocity="3"/>
  </joint>
  <joint name="tip_fixed" type="fixed">
    <parent link="link2"/><child link="tip"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
  </joint>
</robot>
